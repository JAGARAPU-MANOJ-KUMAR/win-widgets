{
  "name": "omnidesk-widgets",
  "version": "1.0.0",
  "description": "True cross-platform floating desktop screen widgets for work tracking, timetable scheduling, and fast notes.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite build && electron electron/main.js",
    "electron:dev": "vite build && electron electron/main.js",
    "electron:start": "vite build && electron electron/main.js",
    "build:exe": "npm run build && electron-builder --win nsis",
    "build:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.omnidesk.widgets",
    "productName": "OmniDesk Widgets",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniDesk Widgets"
    }
  },
  "keywords": [
    "widgets",
    "desktop-widgets",
    "work-tracker",
    "timetable",
    "notion-alternative",
    "productivity",
    "time-blocking",
    "scratchpad"
  ],
  "author": "Manoj",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
